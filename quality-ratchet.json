{
  "schemaVersion": 1,
  "scope": {
    "include": [
      "src/**"
    ]
  },
  "checks": {
    "duplication": {
      "formats": [
        "javascript",
        "typescript"
      ]
    },
    "complexity": {
      "mode": "off",
      "reason": "Disposable proposed policy must not weaken its own PR"
    }
  },
  "reports": {
    "testDebt": false,
    "testSize": {
      "enabled": false
    }
  }
}
