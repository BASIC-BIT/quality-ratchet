{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository quality policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "$ref": "#/definitions/globs"
        },
        "exclude": {
          "$ref": "#/definitions/excludes"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "$ref": "#/definitions/complexity"
        },
        "fileSize": {
          "$ref": "#/definitions/fileSize"
        },
        "duplication": {
          "$ref": "#/definitions/duplication"
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "files": {
            "$ref": "#/definitions/globs"
          },
          "reason": {
            "$ref": "#/definitions/reason"
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "complexity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "$ref": "#/definitions/checkMode"
                  },
                  "reason": {
                    "$ref": "#/definitions/reason"
                  },
                  "cyclomatic": {
                    "$ref": "#/definitions/positiveInteger"
                  },
                  "cognitive": {
                    "$ref": "#/definitions/positiveInteger"
                  }
                }
              },
              "fileSize": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "$ref": "#/definitions/checkMode"
                  },
                  "reason": {
                    "$ref": "#/definitions/reason"
                  },
                  "maxLines": {
                    "$ref": "#/definitions/positiveInteger"
                  }
                }
              }
            },
            "minProperties": 1
          }
        },
        "required": ["files", "reason", "checks"]
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testDebt": {
          "type": "boolean"
        },
        "testSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "oversizedLines": {
              "$ref": "#/definitions/positiveInteger"
            }
          }
        }
      }
    }
  },
  "required": ["schemaVersion"],
  "definitions": {
    "globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "repository-glob"
      }
    },
    "excludes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "format": "repository-glob"
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/checkMode"
        },
        "reason": {
          "$ref": "#/definitions/reason"
        },
        "cyclomatic": {
          "$ref": "#/definitions/positiveInteger"
        },
        "cognitive": {
          "$ref": "#/definitions/positiveInteger"
        },
        "include": {
          "$ref": "#/definitions/globs"
        },
        "exclude": {
          "$ref": "#/definitions/excludes"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/globalModeReason"
        }
      ]
    },
    "fileSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/checkMode"
        },
        "reason": {
          "$ref": "#/definitions/reason"
        },
        "maxLines": {
          "$ref": "#/definitions/positiveInteger"
        },
        "include": {
          "$ref": "#/definitions/globs"
        },
        "exclude": {
          "$ref": "#/definitions/excludes"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/globalModeReason"
        }
      ]
    },
    "duplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/definitions/checkMode"
        },
        "reason": {
          "$ref": "#/definitions/reason"
        },
        "minLines": {
          "$ref": "#/definitions/positiveInteger"
        },
        "minTokens": {
          "$ref": "#/definitions/positiveInteger"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/supportedFormat"
          }
        },
        "include": {
          "$ref": "#/definitions/globs"
        },
        "exclude": {
          "$ref": "#/definitions/excludes"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/globalModeReason"
        }
      ]
    },
    "supportedFormat": {
      "enum": [
        "actionscript",
        "ada",
        "antlr4",
        "apex",
        "apl",
        "aspnet",
        "astro",
        "awk",
        "bash",
        "basic",
        "bicep",
        "brainfuck",
        "c",
        "c-header",
        "cfml",
        "cfscript",
        "clojure",
        "cmake",
        "coffeescript",
        "cpp",
        "cpp-header",
        "crystal",
        "csharp",
        "css",
        "csv",
        "d",
        "dart",
        "diff",
        "docker",
        "dot",
        "eiffel",
        "elm",
        "erlang",
        "excel-formula",
        "fortran",
        "fsharp",
        "gdscript",
        "gettext",
        "gherkin",
        "go",
        "graphql",
        "groovy",
        "haml",
        "handlebars",
        "haskell",
        "haxe",
        "hcl",
        "idris",
        "ignore",
        "ini",
        "java",
        "javascript",
        "json",
        "json5",
        "jsx",
        "julia",
        "kotlin",
        "latex",
        "less",
        "lilypond",
        "linker-script",
        "lisp",
        "livescript",
        "llvm",
        "log",
        "lua",
        "makefile",
        "markdown",
        "markup",
        "nsis",
        "objectivec",
        "ocaml",
        "openqasm",
        "oz",
        "pascal",
        "perl",
        "php",
        "plant-uml",
        "plsql",
        "powerquery",
        "powershell",
        "prolog",
        "properties",
        "protobuf",
        "pug",
        "puppet",
        "purescript",
        "python",
        "q",
        "qsharp",
        "r",
        "racket",
        "razor",
        "rescript",
        "robotframework",
        "ruby",
        "rust",
        "sas",
        "sass",
        "scala",
        "scheme",
        "scss",
        "smalltalk",
        "smarty",
        "solidity",
        "soy",
        "sparql",
        "sql",
        "stylus",
        "svelte",
        "swift",
        "tap",
        "tcl",
        "textile",
        "toml",
        "tsx",
        "tt2",
        "turtle",
        "twig",
        "txt",
        "typescript",
        "unrealscript",
        "vbnet",
        "velocity",
        "verilog",
        "vhdl",
        "vue",
        "wgsl",
        "wolfram",
        "xquery",
        "yaml",
        "zig"
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "checkMode": {
      "enum": ["ratchet", "advisory", "off"]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "globalModeReason": {
      "type": "object",
      "if": {
        "required": ["mode"],
        "properties": {
          "mode": {
            "enum": ["advisory", "off"]
          }
        }
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "$ref": "#/definitions/reason"
          }
        }
      }
    }
  }
}
